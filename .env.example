# Postgres connection string used by the app (Supabase: transaction pooler, port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paperathon
# Session connection used for migrations during `vercel-build` (Supabase: port 5432). Falls back to DATABASE_URL.
DATABASE_MIGRATE_URL=

# Long random string used to sign sessions, OTPs and QR passes: `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string

# Password for the /admin console
ADMIN_PASSWORD=change-me

# Resend (https://resend.com). Without a key, OTP codes are printed to the server console (dev only).
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend
RESEND_FROM="Paper-a-thon <noreply@yourdomain.com>"

# Public URL of the deployed site (used inside QR passes and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Higgsfield API key (only needed to regenerate the hero art: npm run art)
HIGGSFIELD_API_KEY=
